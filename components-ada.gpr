with "components.gpr";

project Components.Ada is

   for Source_Files use
       (  "parsers-generic_ada_parser.adb",
          "parsers-generic_ada_parser.ads",
          "parsers-generic_ada_parser-fold_and_then.adb",
          "parsers-generic_ada_parser-fold_inverse.adb",
          "parsers-generic_ada_parser-fold_not.adb",
          "parsers-generic_ada_parser-fold_or_else.adb",
          "parsers-generic_ada_parser-fold_pow.adb",
          "parsers-generic_ada_parser-generic_dot.adb",
          "parsers-generic_ada_parser-generic_dot.ads",
          "parsers-generic_ada_parser-generic_boolean_folder.adb",
          "parsers-generic_ada_parser-generic_dyadic_folder.adb",
          "parsers-generic_ada_parser-generic_integer_folder.adb",
          "parsers-generic_ada_parser-generic_logical_folder.adb",
          "parsers-generic_ada_parser-generic_text_io.adb",
          "parsers-generic_ada_parser-generic_text_io.ads",
          "parsers-generic_ada_parser-generic_unary_folder.adb",
          "parsers-generic_ada_parser-get_array_type_definition.adb",
          "parsers-generic_ada_parser-get_aspect.adb",
          "parsers-generic_ada_parser-get_case.adb",
          "parsers-generic_ada_parser-get_character_literal.adb",
          "parsers-generic_ada_parser-get_declare.adb",
          "parsers-generic_ada_parser-get_for.adb",
          "parsers-generic_ada_parser-get_identifier.adb",
          "parsers-generic_ada_parser-get_if.adb",
          "parsers-generic_ada_parser-get_numeric_literal.adb",
          "parsers-generic_ada_parser-get_range.adb",
          "parsers-generic_ada_parser-get_raise.adb",
          "parsers-generic_ada_parser-get_simple_name.adb",
          "parsers-generic_ada_parser-get_subtype_indication.adb",
          "parsers-generic_ada_parser-get_subtype_mark.adb",
          "parsers-generic_ada_parser-get_string_literal.adb"
       );

   for Object_Dir use Components'Object_Dir;

   package Compiler renames Components.Compiler;
   package Binder   renames Components.Binder;
   package Builder  renames Components.Builder;
   package Linker   renames Components.Linker;

end Components.Ada;

